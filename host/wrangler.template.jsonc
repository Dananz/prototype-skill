// The local host's config, filled in by `proto share setup --local`: the {{…}} tokens become the KV
// namespace id, the D1 database id, the host's own name (localhost:8787) and "1" for path mode or "0"
// for one origin per share. `wrangler dev --persist-to` makes the namespace and database itself, so
// the ids can be any string. The online host's config is generated by setup instead (its vars add
// SIGNIN, LEGACY and HOST_VERSION, its migrations come from host/migrations, and a daily cron runs).
// A local BASE needs none of those: sign-in works on it with the secrets alone.
{
  "name": "proto-share",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [{ "binding": "KV", "id": "{{KV_ID}}" }],
  "d1_databases": [{ "binding": "DB", "database_name": "proto-share", "database_id": "{{DB_ID}}" }],
  "vars": { "BASE": "{{BASE}}", "PATH_MODE": "{{PATH_MODE}}" }
}
